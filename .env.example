# Supabase project config for the Challenge Tracker feature.
# See SUPABASE_SETUP.md for the full setup walkthrough.
# The site builds and runs fine with these unset -- challenges just show
# an empty/"coming soon" state until a project is connected.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics (GA4). See ANALYTICS_SETUP.md for the full walkthrough.
# The site builds and runs fine with this unset -- no tracking script is
# rendered until it's provided.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email provider for the /contact enquiry form (src/pages/api/contact).
# Without either of the two options below set, enquiries still submit and
# persist in Supabase -- they're just not emailed, and notification_status
# stays unset on each row for staff to catch and follow up manually.
# See src/lib/email/index.ts.

# Option A (preferred) -- Azure Communication Services, the same way the
# Inscend monorepo already sends mail in production (see
# node/src/services/email.service.ts and node/scripts/check-smtp.py
# there). Reuses proven infrastructure instead of a new signup, but it is
# NOT a copy-paste of Inscend's own values: that resource is verified to
# send from Inscend's domain, not this one. Someone with access to that
# Azure Communication Services resource needs to add datafellowsai.com
# (or just info@datafellowsai.com) as an additional verified sender
# domain on it first, then set these to the resulting values:
EMAIL_HOST=smtp.azurecomm.net
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Option B -- Resend (plain HTTP, no SDK). Get a key at https://resend.com
# -- the sending domain (whatever CONTACT_FROM_EMAIL/EMAIL_FROM uses, or
# datafellowsai.com by default) must be verified there before sends will
# succeed. Used only if the Azure Communication Services variables above
# are not set.
RESEND_API_KEY=

# Optional -- overrides EMAIL_FROM for this form specifically if both are
# set. Otherwise defaults to EMAIL_FROM, then to
# "Data Fellows <info@datafellowsai.com>" (see site.enquiryEmail in
# src/constants/site.ts). Must be a sender your email provider is
# authorized to send from.
CONTACT_FROM_EMAIL=

# Not yet implemented -- reserved for a future HubSpot sync on enquiry
# submission (see PART 3 of the enquiry-form brief). A private app token
# with crm.objects.contacts.write scope from a HubSpot private app.
HUBSPOT_PRIVATE_APP_TOKEN=
