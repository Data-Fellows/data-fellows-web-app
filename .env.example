# Supabase project config for the Challenge Tracker feature.
# See SUPABASE_SETUP.md for the full setup walkthrough.
# The site builds and runs fine with these unset -- challenges just show
# an empty/"coming soon" state until a project is connected.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics (GA4). See ANALYTICS_SETUP.md for the full walkthrough.
# The site builds and runs fine with this unset -- no tracking script is
# rendered until it's provided.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
