# Supabase project config for the Challenge Tracker feature.
# See SUPABASE_SETUP.md for the full setup walkthrough.
# The site builds and runs fine with these unset -- challenges just show
# an empty/"coming soon" state until a project is connected.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics (GA4). See ANALYTICS_SETUP.md for the full walkthrough.
# The site builds and runs fine with this unset -- no tracking script is
# rendered until it's provided.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email provider for the /contact enquiry form (src/pages/api/contact).
# Without this, enquiries still submit and persist in Supabase -- they're
# just not emailed, and notification_status stays unset on each row for
# staff to catch and follow up manually. See src/lib/email/index.ts.
# Get a key at https://resend.com -- the sending domain (whatever
# CONTACT_FROM_EMAIL uses, or datafellowsai.com by default) must be
# verified there before sends will succeed.
RESEND_API_KEY=

# Optional -- defaults to "Data Fellows <info@datafellowsai.com>" (see
# site.enquiryEmail in src/constants/site.ts) if unset. Must be a sender
# your email provider is authorized to send from.
CONTACT_FROM_EMAIL=

# Not yet implemented -- reserved for a future HubSpot sync on enquiry
# submission (see PART 3 of the enquiry-form brief). A private app token
# with crm.objects.contacts.write scope from a HubSpot private app.
HUBSPOT_PRIVATE_APP_TOKEN=
